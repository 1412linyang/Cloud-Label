<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>分类待办事项 - 自定义分类</title>
    <style>
        /* 基础样式继承主分支 */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f7fa;
            color: #333;
            line-height: 1.6;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 25px;
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 25px;
            font-size: 28px;
        }

        .add-task-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .add-task-section input,
        .add-task-section select,
        .add-task-section button {
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
        }

        .add-task-section input {
            flex: 1;
            min-width: 200px;
        }

        .add-task-section button {
            background-color: #3498db;
            color: white;
            border: none;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .add-task-section button:hover {
            background-color: #2980b9;
        }

        .category-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 25px;
            justify-content: center;
        }

        .category-tab {
            padding: 10px 16px;
            background-color: #e0e0e0;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 14px;
        }

        .category-tab.active,
        .category-tab:hover {
            background-color: #3498db;
            color: white;
        }

        /* 新增：自定义分类样式 */
        .custom-category-section {
            margin: 20px 0;
            padding: 15px;
            background-color: #f8f9fa;
            border-radius: 8px;
            border: 1px dashed #ddd;
        }

        .custom-category-section h3 {
            margin-bottom: 15px;
            color: #2c3e50;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .custom-category-section h3 i {
            color: #9b59b6;
        }

        .custom-category-form {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        .custom-category-form input {
            flex: 1;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .custom-category-form button {
            background-color: #9b59b6;
            color: white;
            border: none;
            padding: 0 15px;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .custom-category-form button:hover {
            background-color: #8e44ad;
        }

        .custom-categories {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }

        .custom-category-tag {
            background-color: #9b59b6;
            color: white;
            padding: 6px 12px;
            border-radius: 15px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
            position: relative;
            padding-right: 24px;
        }

        .custom-category-tag:hover {
            background-color: #8e44ad;
            transform: translateY(-1px);
        }

        .delete-category-btn {
            position: absolute;
            right: 5px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: white;
            cursor: pointer;
            font-size: 14px;
            opacity: 0.7;
            transition: opacity 0.2s;
        }

        .custom-category-tag:hover .delete-category-btn {
            opacity: 1;
        }

        /* 任务列表样式 */
        .task-list {
            list-style: none;
        }

        .task-item {
            display: flex;
            align-items: center;
            padding: 15px;
            margin-bottom: 12px;
            background-color: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #3498db;
            transition: all 0.3s;
        }

        .task-item.completed {
            opacity: 0.7;
            border-left-color: #2ecc71;
        }

        .task-item.completed .task-text {
            text-decoration: line-through;
        }

        .task-checkbox {
            margin-right: 15px;
        }

        .task-text {
            flex: 1;
        }

        .task-category {
            background-color: #3498db;
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 12px;
            margin-right: 10px;
        }

        .delete-btn {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
        }

        .stats {
            display: flex;
            justify-content: space-between;
            margin-top: 25px;
            padding-top: 15px;
            border-top: 1px solid #eee;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #999;
        }

        /* 新增：分类迁移提示样式 */
        .migration-hint {
            font-size: 12px;
            color: #666;
            margin-top: 5px;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>📋 分类待办事项</h1>

        <div class="add-task-section">
            <input type="text" id="taskInput" placeholder="输入新的待办事项...">
            <select id="categorySelect">
                <option value="工作">工作</option>
                <option value="学习">学习</option>
                <option value="生活">生活</option>
                <option value="购物">购物</option>
                <option value="其他">其他</option>
                <!-- 自定义分类将动态添加到这里 -->
            </select>
            <button onclick="addTask()">添加任务</button>
        </div>

        <div class="category-tabs">
            <button class="category-tab active" onclick="filterTasks('全部', this)">全部</button>
            <button class="category-tab" onclick="filterTasks('工作', this)">工作</button>
            <button class="category-tab" onclick="filterTasks('学习', this)">学习</button>
            <button class="category-tab" onclick="filterTasks('生活', this)">生活</button>
            <button class="category-tab" onclick="filterTasks('购物', this)">购物</button>
            <button class="category-tab" onclick="filterTasks('其他', this)">其他</button>
            <!-- 自定义分类标签将动态添加到这里 -->
        </div>

        <!-- 自定义分类管理区域 -->
        <div class="custom-category-section">
            <h3><i>🏷️</i> 自定义分类管理</h3>
            <div class="custom-category-form">
                <input type="text" id="newCategoryInput" placeholder="输入新分类名称（如：健身、阅读）">
                <button onclick="addCustomCategory()">添加分类</button>
            </div>
            <p class="migration-hint">删除分类时，该分类下的任务将自动迁移到「其他」分类</p>
            <div class="custom-categories" id="customCategoriesContainer">
                <!-- 自定义分类标签将动态显示 -->
            </div>
        </div>

        <ul class="task-list" id="taskList">
            <!-- 任务项将动态添加 -->
        </ul>

        <div class="stats">
            <span>总计: <span id="totalTasks">0</span> 项</span>
            <span>完成: <span id="completedTasks">0</span> 项</span>
        </div>
    </div>

    <script>
        // 数据管理
        let tasks = JSON.parse(localStorage.getItem('tasks')) || [];
        let customCategories = JSON.parse(localStorage.getItem('customCategories')) || [];
        const reservedCategories = new Set(['全部', '工作', '学习', '生活', '购物', '其他']);

        // 初始化
        document.addEventListener('DOMContentLoaded', function() {
            renderTasks();
            renderCustomCategories();
            updateStats();
        });

        // 自定义分类核心功能
        function addCustomCategory() {
            const input = document.getElementById('newCategoryInput');
            const categoryName = input.value.trim();

            if (!categoryName) {
                alert('请输入分类名称');
                return;
            }

            // 验证分类名称
            if (reservedCategories.has(categoryName)) {
                alert(`"${categoryName}" 是系统内置分类，不能重复创建`);
                return;
            }
            if (customCategories.includes(categoryName)) {
                alert(`"${categoryName}" 分类已存在`);
                return;
            }

            // 添加新分类
            customCategories.push(categoryName);
            saveCustomCategories();
            renderCustomCategories(); // 更新UI
            input.value = '';
        }

        function renderCustomCategories() {
            const container = document.getElementById('customCategoriesContainer');
            container.innerHTML = '';

            // 更新分类选择框和筛选标签
            const categorySelect = document.getElementById('categorySelect');
            const categoryTabs = document.querySelector('.category-tabs');
            
            // 保存当前选中值
            const currentSelectValue = categorySelect.value;
            
            // 清除现有自定义选项（保留前5个系统选项）
            while (categorySelect.options.length > 5) {
                categorySelect.remove(5);
            }

            // 清除现有自定义筛选标签（保留前6个系统标签）
            const existingCustomTabs = document.querySelectorAll('.category-tab[data-is-custom="true"]');
            existingCustomTabs.forEach(tab => tab.remove());

            // 渲染自定义分类
            customCategories.forEach(category => {
                // 1. 渲染分类标签
                const tag = document.createElement('span');
                tag.className = 'custom-category-tag';
                tag.textContent = category;
                tag.title = `点击快速添加任务到「${category}」`;
                tag.onclick = () => addTaskToCategory(category);

                // 删除按钮
                const deleteBtn = document.createElement('button');
                deleteBtn.className = 'delete-category-btn';
                deleteBtn.textContent = '×';
                deleteBtn.title = `删除「${category}」分类`;
                deleteBtn.onclick = (e) => {
                    e.stopPropagation();
                    deleteCustomCategory(category);
                };
                tag.appendChild(deleteBtn);
                container.appendChild(tag);

                // 2. 添加到分类选择框
                const option = document.createElement('option');
                option.value = category;
                option.textContent = category;
                categorySelect.appendChild(option);

                // 3. 添加到筛选标签
                const tab = document.createElement('button');
                tab.className = 'category-tab';
                tab.textContent = category;
                tab.setAttribute('data-is-custom', 'true');
                tab.onclick = () => filterTasks(category, tab);
                categoryTabs.appendChild(tab);
            });

            // 恢复选中状态
            if (currentSelectValue && !reservedCategories.has(currentSelectValue)) {
                categorySelect.value = currentSelectValue;
            }
        }

        function deleteCustomCategory(category) {
            if (!confirm(`确定要删除「${category}」分类吗？\n该分类下的所有任务将被迁移到「其他」分类。`)) {
                return;
            }

            // 1. 从分类列表中移除
            customCategories = customCategories.filter(c => c !== category);
            saveCustomCategories();

            // 2. 迁移该分类下的任务到「其他」
            tasks = tasks.map(task => {
                if (task.category === category) {
                    return { ...task, category: '其他' };
                }
                return task;
            });
            saveTasks();

            // 3. 更新UI
            renderCustomCategories();
            renderTasks();
            updateStats();
        }

        // 任务管理（扩展支持自定义分类）
        function addTask() {
            const taskInput = document.getElementById('taskInput');
            const categorySelect = document.getElementById('categorySelect');
            const text = taskInput.value.trim();

            if (!text) return;

            const newTask = {
                id: Date.now(),
                text,
                completed: false,
                category: categorySelect.value,
                createdAt: new Date().toISOString()
            };

            tasks.push(newTask);
            saveTasks();
            renderTasks();
            updateStats();
            taskInput.value = '';
        }

        // 快速添加到指定自定义分类
        function addTaskToCategory(category) {
            const taskInput = document.getElementById('taskInput');
            const text = taskInput.value.trim();

            if (!text) {
                taskInput.focus();
                return;
            }

            const newTask = {
                id: Date.now(),
                text,
                completed: false,
                category,
                createdAt: new Date().toISOString()
            };

            tasks.push(newTask);
            saveTasks();
            renderTasks();
            updateStats();
            taskInput.value = '';
        }

        // 其他任务相关函数（保持基础功能）
        function renderTasks() {
            const taskList = document.getElementById('taskList');
            const activeFilter = document.querySelector('.category-tab.active')?.textContent || '全部';

            let filteredTasks = tasks;
            if (activeFilter !== '全部') {
                filteredTasks = tasks.filter(task => task.category === activeFilter);
            }

            taskList.innerHTML = filteredTasks.length 
                ? filteredTasks.map(task => `
                    <li class="task-item ${task.completed ? 'completed' : ''}">
                        <input type="checkbox" class="task-checkbox" ${task.completed ? 'checked' : ''}
                               onchange="toggleTask(${task.id})">
                        <span class="task-text">${task.text}</span>
                        <span class="task-category">${task.category}</span>
                        <button class="delete-btn" onclick="deleteTask(${task.id})">删除</button>
                    </li>
                `).join('')
                : '<div class="empty-state">暂无任务</div>';
        }

        function toggleTask(id) {
            tasks = tasks.map(task => task.id === id ? { ...task, completed: !task.completed } : task);
            saveTasks();
            renderTasks();
            updateStats();
        }

        function deleteTask(id) {
            tasks = tasks.filter(task => task.id !== id);
            saveTasks();
            renderTasks();
            updateStats();
        }

        function filterTasks(filter, el) {
            document.querySelectorAll('.category-tab').forEach(tab => tab.classList.remove('active'));
            el.classList.add('active');
            renderTasks();
        }

        function updateStats() {
            document.getElementById('totalTasks').textContent = tasks.length;
            document.getElementById('completedTasks').textContent = tasks.filter(t => t.completed).length;
        }

        // 存储函数
        function saveTasks() {
            localStorage.setItem('tasks', JSON.stringify(tasks));
        }

        function saveCustomCategories() {
            localStorage.setItem('customCategories', JSON.stringify(customCategories));
        }

        // 键盘快捷操作
        document.getElementById('taskInput').addEventListener('keypress', e => {
            if (e.key === 'Enter') addTask();
        });

        document.getElementById('newCategoryInput').addEventListener('keypress', e => {
            if (e.key === 'Enter') addCustomCategory();
        });
    </script>
</body>
</html>
    
